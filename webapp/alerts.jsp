<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fraud Alerts & Security Notices | FraudShield AI</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #0b1329;
            color: #e2e8f0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }
        .navbar-custom {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .card-custom {
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 1rem;
        }
        .alert-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 0.75rem;
            padding: 1.25rem;
            margin-bottom: 1rem;
            transition: all 0.2s ease;
        }
        .alert-card:hover {
            background: rgba(15, 23, 42, 0.9);
            border-color: rgba(255, 255, 255, 0.2);
        }
        .alert-critical { border-left: 5px solid #ef4444; }
        .alert-high { border-left: 5px solid #f97316; }
        .alert-medium { border-left: 5px solid #eab308; }
        .alert-low { border-left: 5px solid #3b82f6; }
    </style>
</head>
<body>

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="${pageContext.request.contextPath}/alerts">
            <span class="p-2 rounded-3 bg-danger text-white"><i class="bi bi-shield-exclamation"></i></span>
            <span>FraudShield <span class="text-danger">Alerts & Escalations</span></span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <c:choose>
                <c:when test="${sessionScope.role == 'ADMIN'}">
                    <a href="${pageContext.request.contextPath}/admin/dashboard" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Admin Console
                    </a>
                </c:when>
                <c:otherwise>
                    <a href="${pageContext.request.contextPath}/user/dashboard" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Member Dashboard
                    </a>
                </c:otherwise>
            </c:choose>
            <div class="dropdown">
                <button class="btn btn-dark btn-sm dropdown-toggle border-secondary" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle me-1"></i> ${sessionScope.username}
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                    <li><a class="dropdown-item text-danger" href="${pageContext.request.contextPath}/logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="container px-4 py-4" style="max-width: 1000px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-white mb-1"><i class="bi bi-bell-fill text-warning me-2"></i>Security Incident Notices</h4>
            <p class="text-secondary small mb-0">Prioritized triage notices generated by heuristic and ML anomaly engines</p>
        </div>
        <a href="${pageContext.request.contextPath}/alerts" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh Notices
        </a>
    </div>

    <div class="card-custom p-4">
        <c:forEach var="al" items="${alerts}">
            <div class="alert-card ${al.severity == 'CRITICAL' ? 'alert-critical' : (al.severity == 'HIGH' ? 'alert-high' : (al.severity == 'MEDIUM' ? 'alert-medium' : 'alert-low'))}">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge ${al.severity == 'CRITICAL' ? 'bg-danger' : (al.severity == 'HIGH' ? 'bg-danger-subtle text-danger' : (al.severity == 'MEDIUM' ? 'bg-warning text-dark' : 'bg-primary'))}">
                                ${al.severity}
                            </span>
                            <span class="fw-mono text-info small fw-bold">TX: ${al.transactionId}</span>
                            <c:if test="${al.read}">
                                <span class="badge bg-secondary small"><i class="bi bi-check2"></i> Read</span>
                            </c:if>
                        </div>
                        <div class="text-white mb-2">${al.alertReason}</div>
                        <div class="small text-secondary">
                            <i class="bi bi-clock me-1"></i>
                            <fmt:formatDate value="${al.createdAt}" pattern="yyyy-MM-dd HH:mm:ss"/>
                            <span class="mx-2">|</span>
                            <i class="bi bi-person me-1"></i> Target User ID: #${al.userId}
                        </div>
                    </div>
                    <div>
                        <c:if test="${not al.read}">
                            <form action="${pageContext.request.contextPath}/alerts" method="POST">
                                <input type="hidden" name="alertId" value="${al.alertId}">
                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Acknowledge and mark read">
                                    <i class="bi bi-check2-all"></i> Mark Read
                                </button>
                            </form>
                        </c:if>
                    </div>
                </div>
            </div>
        </c:forEach>

        <c:if test="${empty alerts}">
            <div class="text-center py-5 text-secondary">
                <i class="bi bi-shield-check fs-1 text-success d-block mb-2"></i>
                <h5>All Clear! No Active Security Incidents</h5>
                <p class="small">The fraud detection engine has not registered any suspicious alerts.</p>
            </div>
        </c:if>
    </div>

</div>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
